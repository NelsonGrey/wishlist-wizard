rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for better security
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(resource) {
      return request.auth.uid == resource.data.userId;
    }
    
    function isOwnerId(resource) {
      return request.auth.uid == resource.data.ownerId;
    }
    
    function isCollaborator(wishlistId) {
      return exists(/databases/$(database)/documents/collaborators/$(wishlistId + '_' + request.auth.uid));
    }

    function collaboratorRole(wishlistId) {
      return get(/databases/$(database)/documents/collaborators/$(wishlistId + '_' + request.auth.uid)).data.role;
    }

    // 'owner' is never stored in a collaborators doc (implicit via
    // wishlists/{id}.userId) — callers combine this with an owner check.
    function isEditorCollaborator(wishlistId) {
      return isCollaborator(wishlistId) && collaboratorRole(wishlistId) == 'editor';
    }

    function isReserveCapableCollaborator(wishlistId) {
      return isCollaborator(wishlistId) &&
        (collaboratorRole(wishlistId) == 'editor' || collaboratorRole(wishlistId) == 'commenter');
    }

    function canAccessWishlist(wishlistId) {
      let wishlist = get(/databases/$(database)/documents/wishlists/$(wishlistId));
      return wishlist.data.userId == request.auth.uid ||
             wishlist.data.isPublic == true ||
             isCollaborator(wishlistId);
    }

    function isWishlistOwner(wishlistId) {
      return get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.userId == request.auth.uid;
    }

    // Full item edit rights (add/edit/delete): owner or editor collaborator.
    function canEditWishlistItems(wishlistId) {
      return isWishlistOwner(wishlistId) || isEditorCollaborator(wishlistId);
    }

    // Reserve/purchase rights: owner, editor, or commenter collaborator.
    function canReserveOrPurchaseItems(wishlistId) {
      return isWishlistOwner(wishlistId) || isReserveCapableCollaborator(wishlistId);
    }

    // A commenter's item update must touch only reservation/purchase
    // fields, matching exactly what reserveWishlistItem/purchaseWishlistItem
    // (packages/functions/src/api/wishlists.ts) write server-side — this is
    // the field-scoping that lets a commenter reserve/purchase without
    // being able to edit the item itself.
    function isReservationOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['reservedByUserId', 'reservedBy', 'purchasedByUserId', 'purchasedBy', 'purchasedAt', 'updatedAt']);
    }
    
    // Users collection - users can only read/write their own document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Wishlists - users can access their own or collaborative/public wishlists
    match /wishlists/{wishlistId} {
      allow read: if isAuthenticated() && 
        (isOwner(resource) || 
         resource.data.isPublic == true ||
         isCollaborator(wishlistId));
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.userId;
      
      // Editing the wishlist itself (name/description/settings) is an
      // owner/editor action — a viewer or commenter collaborator must not
      // be able to rename or reconfigure a wishlist they don't own.
      allow update: if isAuthenticated() &&
        (isOwner(resource) || isEditorCollaborator(wishlistId));

      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // Wishlist items - access based on wishlist permissions and role.
    // Read stays open to any collaborator (viewer included) or public
    // access, matching canAccessWishlist. Writes are role-scoped: full
    // add/edit/delete needs owner/editor; a commenter may only touch
    // reservation/purchase fields (see isReservationOnlyUpdate); a viewer
    // can do neither.
    match /wishlistItems/{itemId} {
      allow read: if isAuthenticated() && canAccessWishlist(resource.data.wishlistId);

      allow create: if isAuthenticated() && canEditWishlistItems(request.resource.data.wishlistId);

      allow update: if isAuthenticated() && (
        canEditWishlistItems(resource.data.wishlistId) ||
        (canReserveOrPurchaseItems(resource.data.wishlistId) && isReservationOnlyUpdate())
      );

      allow delete: if isAuthenticated() && canEditWishlistItems(resource.data.wishlistId);
    }
    
    // Beneficiaries - users can only access their own beneficiaries
    match /beneficiaries/{beneficiaryId} {
      allow read, write: if isAuthenticated() && isOwnerId(resource);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;
    }
    
    // Notifications - users can only access their own notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Price alerts - users can only access their own price alerts
    match /priceAlerts/{alertId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    
    // Collaborators - readable by authenticated users, writable by wishlist owners
    match /collaborators/{collaboratorId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        get(/databases/$(database)/documents/wishlists/$(request.resource.data.wishlistId)).data.userId == request.auth.uid;
      
      // Owner-only — a collaborator has no legitimate reason to update
      // their own doc (role changes go through updateCollaboratorRole,
      // owner-only server-side; leaving a wishlist is a delete, not an
      // update, see removeCollaborator). A self-update branch here would
      // let a viewer set role:'editor' on themselves directly via the
      // Firestore SDK, bypassing the callable's owner-only check entirely.
      allow update: if isAuthenticated() &&
        get(/databases/$(database)/documents/wishlists/$(resource.data.wishlistId)).data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
        (get(/databases/$(database)/documents/wishlists/$(resource.data.wishlistId)).data.userId == request.auth.uid ||
         request.auth.uid == resource.data.userId);
    }

    // Pending invites (email invites to accounts that don't exist yet) -
    // Admin SDK only. Holds both collaboration invites (email invites to a
    // specific wishlist) and connection-request invites (a `type` field
    // distinguishes them) - inviteCollaborator/sendConnectionRequest/the
    // auth onCreate trigger (packages/functions) are the only
    // writers/readers; no client ever needs direct access, and an invitee
    // shouldn't be able to read pending invites for other emails.
    match /pendingInvites/{inviteId} {
      allow read, write: if false;
    }

    // Outbound collaboration invite emails - same as above, Admin SDK only
    // (written by inviteCollaborator, consumed by
    // triggers/collaboration.ts's sendCollaborationInviteEmail trigger).
    match /outboundCollaborationEmails/{emailId} {
      allow read, write: if false;
    }

    // Outbound connection-request emails - same as above, Admin SDK only
    // (written by sendConnectionRequest, consumed by
    // triggers/collaboration.ts's sendConnectionRequestEmail trigger).
    match /outboundConnectionEmails/{emailId} {
      allow read, write: if false;
    }

    // User-to-user connections (persistent, mutual-consent relationships -
    // distinct from wishlist collaborators, which are scoped to one
    // wishlist and don't require the other side's agreement). Admin SDK
    // only - sendConnectionRequest/respondToConnectionRequest/
    // removeConnection/the auth onCreate trigger are the only writers;
    // listConnections/listPendingConnectionRequests are the only readers,
    // both real callables so results can be scoped and profile data joined
    // in, not a raw client query.
    match /connections/{connectionId} {
      allow read, write: if false;
    }

    // Username reservations (doc ID is the username itself) - Admin SDK
    // only. setUsername's transaction is the only writer; nothing needs
    // direct client access, and a client-side read wouldn't be atomic
    // with the transaction anyway.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Group gifts / gift coordination (if you have this collection)
    match /giftReservations/{reservationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Analytics events (write-only for authenticated users, admin read)
    match /analyticsEvents/{eventId} {
      allow create: if isAuthenticated();
      // Admin read access would be handled by server-side code with admin SDK
    }
    
    // User sessions (for session management if needed)
    match /userSessions/{sessionId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // ─── SUBSCRIPTION SYSTEM (NEW) ───

    // Subscriptions - users can read their own; Cloud Functions write-only
    match /subscriptions/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true)
      );
      allow write: if false; // Cloud Functions only (via admin SDK)
    }

    // Usage metrics - users can read their own; Cloud Functions write-only
    match /usageMetrics/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true)
      );
      allow write: if false; // Cloud Functions only (via admin SDK)
    }

    // Admin users - admin-only access, Cloud Functions manage
    match /adminUsers/{uid} {
      allow read: if isAuthenticated() && 
        (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true);
      allow write: if false; // Cloud Functions only (via admin SDK)
    }

    // Support tickets - users can create and read their own; admins read all
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true)
      );
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.userId;
      
      allow update: if isAuthenticated() && 
        ((get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true) ||
         request.auth.uid == resource.data.userId);
      
      allow delete: if false; // Tickets are immutable via client
    }

    // Audit log - admin-only read; append-only (no updates/deletes)
    match /auditLog/{logId} {
      allow read: if isAuthenticated() &&
        (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true);

      allow create: if false; // Cloud Functions only (via admin SDK)
      allow update, delete: if false; // Append-only, immutable
    }

    // "Notify me" sign-ups for Coming-Soon tiers (Creator and above). Written
    // only by the api router's /api/tier-interest handler via the Admin SDK;
    // no direct client access (a logged-out marketing visitor has no auth
    // anyway, and the capture may include other users' emails).
    match /tierInterest/{interestId} {
      allow read, write: if false;
    }

    // Affiliate commission ledger and everything payout-related - no direct
    // client access at all, not even read, matching affiliateClicks/
    // affiliateConversions above. A financial ledger's every read needs to
    // pass through a callable that can scope to the caller's own uid, redact
    // internal provenance (rawReportRow), and log access - not a raw client
    // query. See commissionLedger.ts / affiliateReconciliation.ts / payouts.ts.
    match /commissionLedger/{ledgerEntryId} {
      allow read, write: if false;
      match /transitions/{transitionId} {
        allow read, write: if false;
      }
    }
    match /commissionAdjustments/{adjustmentId} {
      allow read, write: if false;
    }
    match /payoutBatches/{batchId} {
      allow read, write: if false;
      match /items/{itemId} {
        allow read, write: if false;
      }
    }
    match /creatorPayoutAccounts/{creatorUid} {
      allow read, write: if false;
    }
    match /affiliateReportImports/{importId} {
      allow read, write: if false;
    }
    match /creatorAffiliateTrackingIds/{assignmentId} {
      allow read, write: if false;
    }
    match /affiliateTrackingIdPool/{network} {
      allow read, write: if false;
      match /ids/{poolIdDocId} {
        allow read, write: if false;
      }
    }
  }
}