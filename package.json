{
  "name": "wishlist-wizard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@wishlist-wizard/web",
    "build": "npm run build --workspaces --if-present",
    "build:mobile": "cd packages/mobile && flutter build web --release",
    "build:all": "npm run build && npm run build:mobile",
    "start": "npm run start --workspace=@wishlist-wizard/api-server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "clean": "rm -rf packages/*/node_modules packages/*/dist node_modules",
    "deploy": "./scripts/deploy.sh deploy-all",
    "deploy:web": "./scripts/deploy.sh deploy-web",
    "deploy:api": "./scripts/deploy.sh deploy-api",
    "deploy:mobile": "./scripts/deploy.sh deploy-mobile",
    "package:extension": "./scripts/deploy.sh package-ext",
    "package:extension:release": "./scripts/package-extension-release.sh",
    "preflight:extension": "./scripts/extension-release-preflight.sh",
    "preflight:mobile": "./scripts/mobile-release-preflight.sh",
    "go-live:check": "./scripts/release-readiness-check.sh",
    "test:users:smoke": "node scripts/check-java21.mjs && npm run build --workspace=functions && npx --yes firebase-tools emulators:exec --project wishlist-wizard --only auth,firestore,functions \"node packages/functions/scripts/emulator-smoke-users.cjs\" && npm run test:functions:smoke:firebase-features",
    "test:users:smoke:live": "npm run build --workspace=functions && node packages/functions/scripts/emulator-smoke-users.cjs",
    "test:functions:smoke:all": "node scripts/check-java21.mjs && npm run build --workspace=functions && npx --yes firebase-tools emulators:exec --project wishlist-wizard --only auth,firestore,functions \"node packages/functions/scripts/emulator-smoke-all-functions.cjs\"",
    "test:functions:smoke:firebase-features": "npm run build --workspace=functions && node packages/functions/scripts/firebase-features-smoke.cjs",
    "seed:demo:emulator": "node scripts/check-java21.mjs && npm run build --workspace=functions && npx --yes firebase-tools emulators:exec --project wishlist-wizard --only auth,firestore,functions \"node packages/functions/scripts/firebase-demo-seed.cjs\"",
    "seed:demo:project": "npm run build --workspace=functions && node packages/functions/scripts/firebase-demo-seed.cjs",
    "test:functions:smoke:all:strict": "npm run test:functions:smoke:all",
    "test:functions:smoke:all:env-aware": "SMOKE_TREAT_EXPECTED_DEPENDENCY_GAPS_AS_PASS=true node scripts/check-java21.mjs && npm run build --workspace=functions && SMOKE_TREAT_EXPECTED_DEPENDENCY_GAPS_AS_PASS=true npx --yes firebase-tools emulators:exec --project wishlist-wizard --only auth,firestore,functions \"node packages/functions/scripts/emulator-smoke-all-functions.cjs\"",
    "test:e2e:smoke": "playwright test packages/web/e2e/smoke.spec.ts",
    "test:e2e:tier1": "playwright test packages/web/e2e/tier-1-basic.spec.ts packages/web/e2e/auth-flow.spec.ts",
    "test:e2e:tier1:chromium": "playwright test packages/web/e2e/tier-1-basic.spec.ts packages/web/e2e/auth-flow.spec.ts --project=chromium --workers=1 --reporter=line",
    "test:e2e:tier2": "playwright test packages/web/e2e/tier-2-advanced.spec.ts",
    "test:e2e:all": "playwright test packages/web/e2e/",
    "test:e2e:dev": "TEST_URL=http://localhost:5173 playwright test packages/web/e2e/",
    "test:e2e:staging": "TEST_URL=https://wishlist-wizard-staging.web.app playwright test packages/web/e2e/",
    "test:e2e:prod": "TEST_URL=https://wishlist-wizard-prod.web.app playwright test packages/web/e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui packages/web/e2e/",
    "test:e2e:debug": "playwright test --debug packages/web/e2e/",
    "test:e2e:report": "playwright show-report",
    "test:mobile:uat": "cd packages/mobile && flutter test integration_test/auth_smoke_test.dart",
    "test:mobile:uat:device": "cd packages/mobile && flutter test integration_test/auth_smoke_test.dart -d ${MOBILE_DEVICE_ID:-macos}",
    "requirements:verify": "node scripts/validate-requirements-status.mjs",
    "requirements:traceability": "node scripts/validate-requirements-traceability.mjs",
    "metrics:baseline": "node scripts/monitor-baseline-metrics.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "esbuild": "^0.25.10"
  }
}
