# 🚀 Wishlist Wizard - Automation Configuration
# Copy this file to .env.automation and customize for your environment

# ==========================================
# NOTIFICATION SETTINGS
# ==========================================

# Email address for critical alerts and weekly reports
ALERT_EMAIL=admin@wishlist-wizard.com

# Slack webhook URL for real-time notifications
SLACK_WEBHOOK=https://example.invalid/slack-webhook

# ==========================================
# MONITORING CONFIGURATION
# ==========================================

# Monitoring interval in seconds (default: 300 = 5 minutes)
MONITOR_INTERVAL=300

# Log file locations
LOG_FILE=automation.log
MONITORING_LOG=monitoring.log
HEALTH_FILE=health-status.json

# Alert thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90
RESPONSE_TIME_THRESHOLD=5000

# ==========================================
# DOCKER CONFIGURATION
# ==========================================

# Private Docker registry (leave empty for Docker Hub)
DOCKER_REGISTRY=your-registry.com

# Docker registry credentials
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Token rotation intervals (in days)
GITHUB_TOKEN_ROTATION_DAYS=30
FIREBASE_TOKEN_ROTATION_DAYS=7
JWT_SECRET_ROTATION_DAYS=90
ENCRYPTION_KEY_ROTATION_DAYS=180
SSL_CERT_RENEWAL_DAYS=30

# ==========================================
# BACKUP CONFIGURATION
# ==========================================

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=7

# Backup schedule (daily, weekly, monthly)
BACKUP_SCHEDULE=daily

# Backup storage location
BACKUP_DIR=./backups

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================

# Enable debug logging
DEBUG_MODE=false

# Enable dry-run mode for testing
DRY_RUN_DEFAULT=false

# ==========================================
# EXTERNAL SERVICE CONFIGURATION
# ==========================================

# Firebase project IDs for each environment
FIREBASE_PROJECT_DEV=wishlist-wizard-dev
FIREBASE_PROJECT_STAGING=wishlist-wizard-staging
FIREBASE_PROJECT_PRODUCTION=wishlist-wizard-prod

# GitHub repository information
GITHUB_ORG=mnelson3
GITHUB_REPO=wishlist-wizard

# ==========================================
# ADVANCED SETTINGS
# ==========================================

# Custom script directories
CUSTOM_SCRIPTS_DIR=./scripts/custom

# Temporary file cleanup (in days)
TEMP_FILE_RETENTION_DAYS=1

# Health check timeouts (in seconds)
HEALTH_CHECK_TIMEOUT=30

# ==========================================
# SAMPLE PRODUCTION VALUES
# ==========================================
# Uncomment and modify for production use:

# ALERT_EMAIL=devops@wishlist-wizard.com
# SLACK_WEBHOOK=https://example.invalid/slack-webhook
# MONITOR_INTERVAL=60
# DOCKER_REGISTRY=registry.wishlist-wizard.com
# BACKUP_RETENTION_DAYS=30
# BACKUP_SCHEDULE=weekly