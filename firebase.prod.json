{
  "dataconnect": {
    "source": "./dataconnect"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "packages/functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "hosting": {
    "public": "packages/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/api/**",
        "destination": "/"
      },
      {
        "source": "/app/**",
        "destination": "/"
      },
      {
        "source": "/login",
        "destination": "/"
      },
      {
        "source": "/register",
        "destination": "/"
      },
      {
        "source": "/forgot-password",
        "destination": "/"
      },
      {
        "source": "/reset-password",
        "destination": "/"
      },
      {
        "source": "/verify-email",
        "destination": "/"
      },
      {
        "source": "/dashboard",
        "destination": "/"
      },
      {
        "source": "/wishlists/**",
        "destination": "/"
      },
      {
        "source": "/user-profile",
        "destination": "/"
      },
      {
        "source": "/recommendations",
        "destination": "/"
      },
      {
        "source": "/calendar",
        "destination": "/"
      },
      {
        "source": "/notifications",
        "destination": "/"
      },
      {
        "source": "/privacy-settings",
        "destination": "/"
      },
      {
        "source": "/shared/**",
        "destination": "/"
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "dataconnect": {
      "port": 9399
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
