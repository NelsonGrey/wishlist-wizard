{
  "manifest_version": 3,
  "name": "WishKeeper",
  "version": "1.0.0",
  "description": "Create wishlists from your favorite shopping sites with just one click",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.target.com/*",
    "*://*.walmart.com/*",
    "*://*.wishkeeper.replit.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.target.com/*",
        "*://*.walmart.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}