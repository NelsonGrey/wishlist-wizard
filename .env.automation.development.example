# 🚀 Wishlist Wizard - Automation Configuration
# Copy this file to .env.automation.development and customize for your environment

# ==========================================
# NOTIFICATION SETTINGS
# ==========================================

# Email address for critical alerts and weekly reports
ALERT_EMAIL=admin@wishlist-wizard.com

# Slack webhook URL for real-time notifications
SLACK_WEBHOOK=https://example.invalid/slack-webhook

# ==========================================
# MONITORING CONFIGURATION
# ==========================================

# Monitoring interval in seconds (default: 300 = 5 minutes)
MONITOR_INTERVAL=300

# Log file locations
LOG_FILE=automation.log
MONITORING_LOG=monitoring.log
HEALTH_FILE=health-status.json

# Alert thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90
RESPONSE_TIME_THRESHOLD=5000

# ==========================================
# DOCKER CONFIGURATION
# ==========================================

# Private Docker registry (leave empty for Docker Hub)
DOCKER_REGISTRY=your-registry.com

# Docker registry credentials
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Token rotation intervals (in days)
GITHUB_TOKEN_ROTATION_DAYS=30
FIREBASE_TOKEN_ROTATION_DAYS=7
JWT_SECRET_ROTATION_DAYS=90
ENCRYPTION_KEY_ROTATION_DAYS=180
SSL_CERT_RENEWAL_DAYS=30

# ==========================================
# BACKUP CONFIGURATION
# ==========================================

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=7

# Backup schedule (daily, weekly, monthly)
BACKUP_SCHEDULE=daily

# Backup storage location
BACKUP_DIR=./backups

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================

# Enable debug logging
DEBUG_MODE=false

# Enable dry-run mode for testing
DRY_RUN_DEFAULT=false

# ==========================================
# MOBILE APP CONFIGURATION
# ==========================================

# Flutter SDK path (leave empty to use system PATH)
FLUTTER_PATH=

# Mobile app bundle identifiers
MOBILE_BUNDLE_ID=com.nelsongrey.wishlistwizard.mobile
MOBILE_ANDROID_PACKAGE=com.nelsongrey.wishlistwizard.mobile

# ==========================================
# iOS APP STORE CONNECT
# ==========================================

# Apple Developer Account
APP_STORE_CONNECT_KEY_ID=your_app_store_connect_key_id
APP_STORE_CONNECT_ISSUER_ID=your_app_store_connect_issuer_id
APP_STORE_CONNECT_KEY=-----BEGIN APP_STORE_CONNECT_KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----
FASTLANE_APPLE_ID=your_apple_id@email.com
FASTLANE_TEAM_ID=your_team_id
FASTLANE_ITC_TEAM_ID=your_itc_team_id

# iOS Code Signing
MATCH_GIT_URL=https://github.com/your-org/ios-certificates.git
MATCH_PASSWORD=your_match_password

# TestFlight Configuration
BETA_FEEDBACK_EMAIL=feedback@wishlistwizard.com
BETA_TESTER_GROUPS=internal-testers,beta-testers

# ==========================================
# ANDROID GOOGLE PLAY STORE
# ==========================================

# Google Play Service Account (JSON content)
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Android Keystore Configuration
ANDROID_KEYSTORE_PATH=./android/keystore.jks
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=your_key_password

# Google Play Track Configuration
ANDROID_TRACK=internal  # internal, alpha, beta, production
ANDROID_IN_APP_UPDATE_PRIORITY=3  # 0-5, higher = more aggressive updates

# ==========================================
# MOBILE BUILD CONFIGURATION
# ==========================================

# Build modes
MOBILE_BUILD_MODE=release  # debug, profile, release

# Build targets
MOBILE_TARGET_PLATFORM=android-arm64,android-arm  # ios, android-arm, android-arm64, android-x64

# Build numbers (auto-incremented)
MOBILE_BUILD_NUMBER=1

# Version name/code
MOBILE_VERSION_NAME=1.0.0
MOBILE_VERSION_CODE=1

# ==========================================
# MOBILE DEPLOYMENT SETTINGS
# ==========================================

# Deployment targets
DEPLOY_IOS_TESTFLIGHT=true
DEPLOY_IOS_APPSTORE=false
DEPLOY_ANDROID_INTERNAL=true
DEPLOY_ANDROID_BETA=false
DEPLOY_ANDROID_PRODUCTION=false

# Deployment notes
DEPLOYMENT_NOTES="Automated deployment from CI/CD pipeline"

# ==========================================
# EXTERNAL SERVICE CONFIGURATION
# ==========================================

# Firebase project IDs for each environment
FIREBASE_PROJECT_DEV=wishlist-wizard-dev
FIREBASE_PROJECT_STAGING=wishlist-wizard-staging
FIREBASE_PROJECT_PRODUCTION=wishlist-wizard-prod

# GitHub repository information
GITHUB_ORG=mnelson3
GITHUB_REPO=wishlist-wizard

# ==========================================
# GITHUB CLI AUTHENTICATION
# ==========================================

# GitHub Personal Access Token (required for zero-touch operation)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow, admin:repo_hook, delete_repo
GH_TOKEN=your_github_personal_access_token_here

# GitHub CLI configuration
GITHUB_CLI_CONFIG_DIR=~/.config/gh
GITHUB_CLI_HOST=github.com

# ==========================================
# ADVANCED SETTINGS
# ==========================================

# Custom script directories
CUSTOM_SCRIPTS_DIR=./scripts/custom

# Temporary file cleanup (in days)
TEMP_FILE_RETENTION_DAYS=1

# Health check timeouts (in seconds)
HEALTH_CHECK_TIMEOUT=30

# ==========================================
# SAMPLE PRODUCTION VALUES
# ==========================================
# Uncomment and modify for production use:

# ALERT_EMAIL=devops@wishlist-wizard.com
