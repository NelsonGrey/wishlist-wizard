# Fastfile for Wishlist Wizard iOS App
# This file contains the lanes for building, testing, and distributing the app

# Import required plugins
# fastlane add_plugin firebase_app_distribution

require 'fileutils'
require 'shellwords'

default_platform(:ios)

platform :ios do
  # Writes APP_STORE_CONNECT_KEY to a temp .p8 FILE PATH, for xcodebuild's
  # -authenticationKeyPath flag (automatic signing via -allowProvisioningUpdates
  # authenticates at the xcodebuild CLI level, not through fastlane's Spaceship
  # session, so it needs a path rather than an api_key object). Same pattern
  # proven working in vehicle-vitals/packages/mobile/ios/fastlane/Fastfile.
  def app_store_connect_key_file_path
    private_key_content = ENV["APP_STORE_CONNECT_KEY"]
    if private_key_content.nil? || private_key_content.empty?
      UI.user_error!("APP_STORE_CONNECT_KEY environment variable is not set or empty")
    end

    unless private_key_content.include?("-----BEGIN")
      require 'base64'
      decoded = Base64.decode64(private_key_content.gsub(/\s+/, ""))
      private_key_content = decoded if decoded.include?("-----BEGIN")
    end

    private_key_content = private_key_content.gsub(/\A['\"]|['\"]\z/, '')
    private_key_content = private_key_content.gsub(/\\n/, "\n")
    private_key_content = private_key_content.gsub(/\r\n?/, "\n")
    private_key_content = private_key_content.lines.map { |l| l.strip }.reject { |l| l.empty? }.join("\n") + "\n"

    unless private_key_content.include?("-----BEGIN PRIVATE KEY-----") || private_key_content.include?("-----BEGIN EC PRIVATE KEY-----")
      UI.user_error!("APP_STORE_CONNECT_KEY could not be converted to a valid .p8 key file")
    end

    require 'tempfile'
    key_file = Tempfile.new(['app_store_connect_xcode_auth', '.p8'])
    key_file.write(private_key_content)
    key_file.flush
    key_file.close

    # Keep a strong reference so Ruby GC does not unlink the tempfile before xcodebuild uses it.
    @xcode_auth_key_tempfile = key_file
    key_file.path
  end

  # Forces the Runner target into automatic signing, then hands signing off
  # to xcodebuild's -allowProvisioningUpdates (via the App Store Connect API
  # key) so Apple creates/reuses the distribution cert + profile directly —
  # no git-based cert storage (match) involved. Same pattern as
  # vehicle-vitals, adopted here after confirming wishlist-wizard's old
  # git-based match setup (pointed at mnelson3/nelson-grey, a repo that
  # never actually held any certificates) was dead/abandoned tooling, not a
  # working setup with a credential problem.
  def ensure_xcode_automatic_signing!
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    raise "Missing FASTLANE_TEAM_ID" if team_id.empty?

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: team_id
    )

    team_id
  end

  desc "Load App Store Connect API Key information to use in subsequent lanes"
  lane :load_asc_api_key do
    # Load APP_STORE_CONNECT_KEY from environment
    asc_raw = ENV["APP_STORE_CONNECT_KEY"]
    if asc_raw
      # If the secret is provided as a single-line base64 (no PEM header), prefer passing
      # it directly to Fastlane via `key_content` with `is_key_content_base64: true`.
      is_pem = asc_raw.include?("-----BEGIN")
      cleaned = asc_raw.gsub(/\s+/, "")
      looks_base64 = cleaned =~ /\A[A-Za-z0-9+\/=]+\z/ && cleaned.length > 100

      if !is_pem && looks_base64
        UI.message("Detected APP_STORE_CONNECT_KEY as base64; passing directly as key_content (is_key_content_base64: true)")
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
          key_content: cleaned,
          is_key_content_base64: true,
          in_house: false
        )
        next
      end

      # Fall back to processing raw PEM-like content
      private_key_content = asc_raw
      # Clean up and normalize the key content
      private_key_content = private_key_content.strip
      # Remove surrounding quotes if present
      private_key_content = private_key_content.gsub(/\A['\"]|['\"]\z/, '')
      # Expand literal \n sequences into real newlines (handle secrets stored as one-liners)
      private_key_content = private_key_content.gsub(/\\n/, "\n")
      # Normalize CRLF -> LF
      private_key_content = private_key_content.gsub(/\r\n?/, "\n")
      # Strip leading/trailing whitespace from each PEM line to avoid 'bad end line' errors
      private_key_content = private_key_content.lines.map { |l| l.strip }.reject { |l| l.empty? }.join("\n") + "\n"

      # If the key doesn't have proper BEGIN/END markers, try base64 decoding
      unless private_key_content.match?(/-----BEGIN [A-Z ]+-----/)
        begin
          require 'base64'
          decoded = Base64.decode64(private_key_content)
          if decoded.include?("-----BEGIN")
            private_key_content = decoded
            UI.message("Decoded APP_STORE_CONNECT_KEY from base64")
          end
        rescue => e
          UI.message("Failed to decode APP_STORE_CONNECT_KEY as base64: #{e.message}")
        end
      end

      # Write the (normalized) key to a temporary file
      require 'tempfile'
      key_file = Tempfile.new(['app_store_connect_key', '.p8'])
      key_file.write(private_key_content)
      key_file.close

      UI.message("Created temporary App Store Connect key file: #{key_file.path}")

      # Attempt multiple OpenSSL conversions to produce a canonical EC PEM that Ruby/OpenSSL accepts.
      converted_path = nil
      use_key_path = key_file.path
      begin
        require 'tmpdir'
        converted_path = File.join(Dir.tmpdir, "app_store_connect_key_converted_#{Time.now.to_i}.p8")

        conversion_cmds = [
          "openssl pkcs8 -in #{key_file.path} -inform PEM -out #{converted_path} -outform PEM -nocrypt 2>&1",
          "openssl pkey -in #{key_file.path} -out #{converted_path} -outform PEM -nocrypt 2>&1",
          "openssl ec -in #{key_file.path} -out #{converted_path} 2>&1"
        ]

        conversion_succeeded = false
        conversion_cmds.each do |cmd|
          UI.message("Trying OpenSSL command: #{cmd}")
          output = `#{cmd}`
          if $?.success? && File.exist?(converted_path) && File.size?(converted_path) && File.size(converted_path) > 0
            UI.message("OpenSSL conversion succeeded with command: #{cmd}")
            use_key_path = converted_path
            conversion_succeeded = true
            break
          else
            UI.message("OpenSSL command failed or produced empty file: #{output}")
            # Ensure no stale converted file remains
            begin; File.delete(converted_path) if File.exist?(converted_path); rescue => _; end
          end
        end
        UI.message("OpenSSL conversion overall success: #{conversion_succeeded}")
      rescue => e
        UI.message("OpenSSL conversion attempt raised: #{e.message}")
        use_key_path = key_file.path
      end

      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: use_key_path,
        in_house: false
      )

      # Clean up temporary files
      begin
        key_file.unlink
      rescue => _; end
      begin
        File.delete(converted_path) if converted_path && File.exist?(converted_path)
      rescue => _; end
    else
      UI.user_error!("APP_STORE_CONNECT_KEY environment variable is not set")
    end
  end

  desc "Install Flutter dependencies"
  lane :flutter_deps do
    Dir.chdir("../../") do
      sh("flutter pub get")
    end
  end

  

  desc "Run Flutter tests"
  lane :flutter_test do
    Dir.chdir("../../") do
      sh("flutter test")
    end
  end

  desc "Build Flutter iOS app in debug mode"
  lane :build_debug do
    flutter_deps
    Dir.chdir("../../") do
      sh("flutter build ios --debug --no-codesign")
    end
  end

  # Every lane in this Fastfile that produces a distributable build (build_release,
  # build_appstore, build_testflight) exists to ship a real artifact, so it must
  # always point at wishlist-wizard-prod — never left to defaults. This swaps in
  # the prod GoogleService-Info.plist (fixing native-SDK config, which the Dart
  # FIREBASE_ENV dart-define does not touch) and fails loudly if the result
  # doesn't actually match the prod project, rather than silently shipping wrong.
  def ensure_prod_firebase_config!
    # Fastlane's working directory during lane execution is this fastlane/
    # directory itself (see sibling "../Pods" references elsewhere in this
    # file), not its parent — so these paths need the "../" prefix to reach
    # Runner/, which lives alongside fastlane/, not inside it.
    prod_plist = "../Runner/GoogleService-Info.prod.plist"
    active_plist = "../Runner/GoogleService-Info.plist"
    UI.user_error!("Missing #{prod_plist}") unless File.exist?(prod_plist)

    FileUtils.cp(prod_plist, active_plist)

    project_id = sh(
      "/usr/libexec/PlistBuddy -c \"Print :PROJECT_ID\" #{active_plist}",
      log: false
    ).to_s.strip

    unless project_id == "wishlist-wizard-prod"
      UI.user_error!(
        "Firebase config guard failed: expected PROJECT_ID=wishlist-wizard-prod " \
        "after swapping in #{prod_plist}, but found '#{project_id}'."
      )
    end

    UI.message("✅ Verified iOS Firebase config points at #{project_id}")
  end

  desc "Build Flutter iOS app in release mode"
  lane :build_release do
    ensure_prod_firebase_config!
    flutter_deps
    Dir.chdir("../../") do
      sh("flutter build ios --release --no-codesign --dart-define=FIREBASE_ENV=production")
    end
  end

  desc "Build and sign iOS app for App Store distribution"
  lane :build_appstore do
    ensure_prod_firebase_config!
    team_id = ensure_xcode_automatic_signing!
    authentication_key_path = app_store_connect_key_file_path
    authentication_key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    authentication_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip

    flutter_deps

    # Clean legacy build artifacts to avoid linker errors
    clear_derived_data
    sh("rm -rf ../Pods")
    sh("rm -f ../Podfile.lock")

    begin
      Dir.chdir("../../") do
        sh("flutter clean")
        sh("flutter pub get")
        # Use --no-codesign to avoid Flutter trying to sign with default (likely Dev) identity
        sh("flutter build ios --release --no-codesign --dart-define=FIREBASE_ENV=production")

        build_app(
          xcargs: [
            "-allowProvisioningUpdates",
            "-authenticationKeyPath #{Shellwords.escape(authentication_key_path)}",
            "-authenticationKeyID #{Shellwords.escape(authentication_key_id)}",
            "-authenticationKeyIssuerID #{Shellwords.escape(authentication_issuer_id)}"
          ].join(" "),
          workspace: "ios/Runner.xcworkspace",
          scheme: "Runner",
          configuration: "Release",
          export_method: "app-store",
          export_options: {
            signingStyle: "automatic",
            teamID: team_id
          },
          clean: true
        )
      end
    ensure
      if @xcode_auth_key_tempfile
        @xcode_auth_key_tempfile.unlink
        @xcode_auth_key_tempfile = nil
      end
    end
  end

  desc "Build and sign iOS app for TestFlight distribution"
  lane :build_testflight do
    ensure_prod_firebase_config!
    team_id = ensure_xcode_automatic_signing!
    authentication_key_path = app_store_connect_key_file_path
    authentication_key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
    authentication_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip

    clear_derived_data
    # Clean workspace to prevent abseil/grpc linking issues
    sh("rm -rf ../Pods")
    sh("rm -f ../Podfile.lock")

    flutter_deps

    # Ensure a clean build environment BEFORE dependencies
    Dir.chdir("../../") do
      sh("rm -rf build")
      sh("flutter clean || true")
      sh("flutter pub get")
    end

    # Build the iOS project once with Flutter so CocoaPods and generated iOS
    # metadata are refreshed before Xcode archive/signing.
    Dir.chdir("../../") do
      sh("flutter build ios --release --no-codesign --dart-define=FIREBASE_ENV=production")
    end

    begin
      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        clean: true,
        export_method: "app-store",
        output_directory: "../../build/ios/ipa",
        output_name: "WishlistWizard.ipa",
        export_options: {
          signingStyle: "automatic",
          teamID: team_id
        },
        xcargs: [
          "-allowProvisioningUpdates",
          "-authenticationKeyPath #{Shellwords.escape(authentication_key_path)}",
          "-authenticationKeyID #{Shellwords.escape(authentication_key_id)}",
          "-authenticationKeyIssuerID #{Shellwords.escape(authentication_issuer_id)}"
        ].join(" ")
      )
    ensure
      if @xcode_auth_key_tempfile
        @xcode_auth_key_tempfile.unlink
        @xcode_auth_key_tempfile = nil
      end
    end

    # Get the actual IPA path from build_app result
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    unless ipa_path && File.exist?(ipa_path)
      UI.user_error!("gym failed to create IPA at #{ipa_path || '../../build/ios/ipa/WishlistWizard.ipa'}")
    end

    UI.message("✅ Successfully created signed IPA at: #{ipa_path}")
  end

  desc "Upload to TestFlight"
  lane :beta do
    # Load App Store Connect API Key
    load_asc_api_key

    # Build the app
    build_testflight

    # Upload to TestFlight
    # Get the IPA path from the build_testflight lane (it's stored in SharedValues)
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    
    if ipa_path.nil? || !File.exist?(ipa_path)
      UI.user_error!("Could not find IPA after build_testflight. IPA path was: #{ipa_path || 'nil'}")
    else
      UI.message("Found IPA at #{ipa_path}")
    end

    # Normalize BETA contact phone to E.164-ish format for App Store Connect
    # Note: beta_app_feedback_phone is no longer supported in current fastlane versions
    raw_contact_phone = ENV["BETA_CONTACT_PHONE"].to_s.strip

    if raw_contact_phone.empty?
      UI.message("No contact phone provided; using default beta_app_review_info contact phone")
    end

    # Use pilot (wrapped by upload_to_testflight)
    # Use api_key from lane context (set by load_asc_api_key indirectly? No, load_asc_api_key returns nil but sets shared values/config)
    # Actually, app_store_connect_api_key sets up the connection for subsequent actions.
    # explicit api_key param is cleaner if available, but fastlane shared config handles it.
    
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      beta_app_feedback_email: "mark.a.nelson@outlook.com",
      # Required once per app before Apple allows distributing a build to an
      # EXTERNAL testing group (distribute_external: true below) — found the
      # hard way: the build itself succeeds and uploads fine, only the final
      # distribute step rejects with "Beta App Description is missing" /
      # "betaAppLocalizations not found for this app" until this is set.
      beta_app_description: "Wishlist Wizard is a smart wishlist management app. Create and share wishlists for any occasion, track prices on items you want, and coordinate group gifting with friends and family so everyone can chip in on bigger gifts.",
      beta_app_review_info: {
        contact_email: ENV["BETA_FEEDBACK_EMAIL"] || "mark.a.nelson@outlook.com",
        contact_first_name: "Mark",
        contact_last_name: "Nelson",
        contact_phone: raw_contact_phone.empty? ? "+16307158474" : raw_contact_phone,
        notes: "No demo account needed — sign-in supports Google, email, or continuing as a guest."
      },
      changelog: "Automated TestFlight build from CI/CD pipeline",
      distribute_external: true,
      groups: [ENV["BETA_GROUP_NAME"] || "Internal Testers"]
    )
  end

  desc "Push App Store text metadata (and screenshots, if present) via the API — never submits for review"
  lane :push_appstore_metadata do
    load_asc_api_key

    # skip_binary_upload/skip_app_version_update: this lane's only job is
    # metadata/screenshots, independent of build_appstore/build_testflight —
    # it does not touch the binary or version number.
    # submit_for_review: false is deliberate and load-bearing: pushing
    # metadata is safe to automate, but actually submitting the app for
    # human review is a separate, consequential action that stays behind an
    # explicit human-triggered step (see submit_appstore_for_review below).
    deliver(
      api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: "com.wishlistwizard.app.ios",
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      skip_app_version_update: true,
      skip_screenshots: !Dir.exist?(File.expand_path("screenshots", __dir__)),
      # Required — without this, deliver tries to fetch/preserve this
      # version's *existing* appStoreReviewDetail and crashes with a
      # spaceship "No data" error when none has ever been created (as found
      # running this for real: fastlane-2.237.0's
      # deliver/upload_metadata.rb:752 review_attachment_file assumes the
      # resource exists). Passing this explicitly makes deliver create it
      # instead of trying to read a nonexistent one.
      app_review_information: {
        first_name: "Mark",
        last_name: "Nelson",
        phone_number: ENV["BETA_CONTACT_PHONE"] || "+16307158474",
        email_address: ENV["BETA_FEEDBACK_EMAIL"] || "mark.a.nelson@outlook.com",
        notes: "No demo account needed — sign-in supports Google, email, or continuing as a guest."
      },
      submit_for_review: false,
      # precheck's IAP-metadata inspection requires Apple ID/2FA auth, not
      # API-key auth — this app authenticates with an API key, so precheck's
      # IAP check must be disabled or it hard-fails regardless of build state.
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Submit the current App Store version for review — irreversible, human-triggered only. Never called by CI automatically."
  lane :submit_appstore_for_review do
    load_asc_api_key

    deliver(
      api_key: Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier: "com.wishlistwizard.app.ios",
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      skip_app_version_update: true,
      skip_screenshots: !Dir.exist?(File.expand_path("screenshots", __dir__)),
      app_review_information: {
        first_name: "Mark",
        last_name: "Nelson",
        phone_number: ENV["BETA_CONTACT_PHONE"] || "+16307158474",
        email_address: ENV["BETA_FEEDBACK_EMAIL"] || "mark.a.nelson@outlook.com",
        notes: "No demo account needed — sign-in supports Google, email, or continuing as a guest."
      },
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # Helper to remove derived data
  def clear_derived_data
    sh("rm -rf ~/Library/Developer/Xcode/DerivedData/*")
  end
end
