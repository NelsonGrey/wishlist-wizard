{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@wishlist-wizard/shared": ["../shared/src"],
      "@wishlist-wizard/shared/*": ["../shared/src/*"]
    },
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["server/**/*", "drizzle.config.ts", "types/**/*"],
  "exclude": ["dist", "node_modules"]
}