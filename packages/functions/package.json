{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "smoke:users": "node ./scripts/emulator-smoke-users.cjs",
    "smoke:all": "node ./scripts/emulator-smoke-all-functions.cjs",
    "smoke:firebase-features": "node ./scripts/firebase-features-smoke.cjs",
    "seed:demo": "node ./scripts/firebase-demo-seed.cjs",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.5.0",
    "globby": "^11.1.0",
    "tsutils": "^3.21.0",
    "typescript": "^5.7.3",
    "zod": "^4.4.3"
  },
  "private": true
}
